import { AboutSlint, ListView } from "std-widgets.slint";

export global UiPalette {
    in-out property <bool> dark-mode: false;
    out property <brush> window: dark-mode ? #1e1e28 : #f4f5f7;
    out property <brush> header: dark-mode ? #20202b : #f7f8fa;
    out property <brush> surface: dark-mode ? #272735 : #fbfbfc;
    out property <brush> surface-strong: dark-mode ? #30303f : #ffffff;
    out property <brush> hover: dark-mode ? #363647 : #e9ecf1;
    out property <brush> pressed: dark-mode ? #404054 : #dde2e9;
    out property <brush> text: dark-mode ? #f8f9fb : #15171a;
    out property <brush> text-muted: dark-mode ? #a6adba : #66707e;
    out property <brush> text-faint: dark-mode ? #777f90 : #929aa7;
    out property <brush> border: dark-mode ? #393947 : #d7dbe2;
    out property <brush> glass-border: dark-mode ? #ffffff18 : #ffffffcc;
    out property <brush> accent: dark-mode ? #60a5fa : #2563eb;
    out property <brush> accent-soft: dark-mode ? #60a5fa30 : #2563eb1f;
    out property <brush> danger: dark-mode ? #f87171 : #ef4444;
    out property <brush> danger-soft: dark-mode ? #f8717133 : #ef44441f;
    out property <brush> amber: #f59e0b;
    out property <brush> amber-soft: #f59e0b24;
}

export struct ClipboardItemData {
    id: string,
    content: string,
    type-label: string,
    created-at: string,
    favorite: bool,
    pinned: bool,
    has-image: bool,
    thumbnail: image,
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../icons/icon.png");
    tooltip: "SnapPaste";
    title: "SnapPaste";

    callback open-requested();
    callback settings-requested();
    callback about-requested();
    callback quit-requested();
    callback tray-clicked();

    clicked => { root.tray-clicked(); }

    Menu {
        MenuItem {
            title: "打开 SnapPaste";
            activated => { root.open-requested(); }
        }
        MenuItem {
            title: "设置";
            activated => { root.settings-requested(); }
        }
        MenuItem {
            title: "关于";
            activated => { root.about-requested(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "退出";
            activated => { root.quit-requested(); }
        }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <brush> tint: UiPalette.text-muted;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 10px;
    border-width: 1px;
    border-color: button-touch.has-hover ? UiPalette.border : transparent;
    background: root.active
        ? UiPalette.amber-soft
        : button-touch.pressed
            ? UiPalette.pressed
            : button-touch.has-hover
                ? (root.danger ? UiPalette.danger-soft : UiPalette.hover)
                : UiPalette.surface;
    opacity: root.enabled ? 1 : 0.42;

    Image {
        x: 8px;
        y: 8px;
        width: 18px;
        height: 18px;
        source: root.icon;
        image-fit: contain;
        colorize: root.active
            ? UiPalette.amber
            : button-touch.has-hover && root.danger
                ? UiPalette.danger
                : root.tint;
    }

    button-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
}

component RowIconButton inherits Rectangle {
    in property <image> icon;
    in property <brush> tint: UiPalette.text-muted;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> revealed: true;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 7px;
    opacity: root.revealed ? 1 : 0;
    background: button-touch.pressed
        ? UiPalette.pressed
        : button-touch.has-hover
            ? (root.danger ? UiPalette.danger-soft : root.active ? UiPalette.amber-soft : UiPalette.accent-soft)
            : transparent;

    Image {
        x: 6px;
        y: 6px;
        width: 16px;
        height: 16px;
        source: root.icon;
        image-fit: contain;
        colorize: button-touch.has-hover && root.danger
            ? UiPalette.danger
            : root.active
                ? UiPalette.amber
                : root.tint;
    }

    button-touch := TouchArea {
        enabled: root.revealed;
        clicked => { root.clicked(); }
    }

    animate opacity { duration: 120ms; }
    animate background { duration: 120ms; }
}

component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    min-width: 56px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.primary
        ? UiPalette.accent
        : root.danger
            ? UiPalette.danger
            : UiPalette.border;
    background: root.primary
        ? (button-touch.pressed ? #1d4ed8 : button-touch.has-hover ? #3474eb : UiPalette.accent)
        : root.danger
            ? (button-touch.pressed ? #dc2626 : button-touch.has-hover ? #f35a5a : UiPalette.danger)
            : button-touch.pressed
                ? UiPalette.pressed
                : button-touch.has-hover
                    ? UiPalette.hover
                    : UiPalette.surface;
    opacity: root.enabled ? 1 : 0.5;

    Text {
        text: root.text;
        color: root.primary || root.danger ? #ffffff : UiPalette.text;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    animate background { duration: 120ms; }
}

component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <bool> centered: false;
    callback edited(string);

    height: 32px;
    border-width: 1px;
    border-radius: 8px;
    border-color: editor.has-focus ? UiPalette.accent : UiPalette.border;
    background: root.enabled ? UiPalette.surface : UiPalette.window;
    forward-focus: editor;

    if editor.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-width: 2px;
        border-radius: 11px;
        border-color: UiPalette.accent-soft;
    }

    Text {
        x: 9px;
        width: parent.width - 18px;
        text: root.text == "" ? root.placeholder-text : "";
        color: UiPalette.text-faint;
        font-size: 12px;
        horizontal-alignment: root.centered ? center : left;
        vertical-alignment: center;
        overflow: elide;
    }

    editor := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: 100%;
        text <=> root.text;
        enabled: root.enabled;
        color: UiPalette.text;
        font-size: 12px;
        single-line: true;
        horizontal-alignment: root.centered ? center : left;
        vertical-alignment: center;
        edited => { root.edited(self.text); }
    }

    animate border-color { duration: 100ms; }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    callback edited(string);

    height: 38px;
    border-width: 1px;
    border-radius: 10px;
    border-color: editor.has-focus ? UiPalette.accent : UiPalette.border;
    background: UiPalette.surface-strong;
    forward-focus: editor;

    if editor.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-width: 2px;
        border-radius: 13px;
        border-color: UiPalette.accent-soft;
    }

    Image {
        x: 12px;
        y: 11px;
        width: 16px;
        height: 16px;
        source: @image-url("icons/search.svg");
        colorize: UiPalette.text-muted;
    }

    Text {
        x: 36px;
        width: parent.width - 48px;
        text: root.text == "" ? root.placeholder-text : "";
        color: UiPalette.text-muted;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    editor := TextInput {
        x: 36px;
        width: root.text == "" ? parent.width - 48px : parent.width - 72px;
        height: 100%;
        text <=> root.text;
        enabled: root.enabled;
        color: UiPalette.text;
        font-size: 12px;
        single-line: true;
        vertical-alignment: center;
        edited => { root.edited(self.text); }
    }

    if root.text != "": RowIconButton {
        x: parent.width - 30px;
        y: 5px;
        icon: @image-url("icons/close.svg");
        tint: UiPalette.text-faint;
        clicked => {
            root.text = "";
            root.edited("");
            editor.focus();
        }
    }
}

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 42px;
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.checked ? UiPalette.accent : UiPalette.border;
    background: root.checked ? UiPalette.accent : UiPalette.surface;

    Rectangle {
        x: root.checked ? 20px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000042;
        animate x { duration: 140ms; easing: ease-in-out; }
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component SegmentButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    height: 30px;
    border-radius: 7px;
    background: root.selected
        ? UiPalette.surface-strong
        : button-touch.has-hover
            ? UiPalette.hover
            : transparent;

    Text {
        text: root.text;
        color: root.selected ? UiPalette.accent : UiPalette.text-muted;
        font-size: 11px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-touch := TouchArea { clicked => { root.clicked(); } }
}

component RecordRow inherits Rectangle {
    in property <ClipboardItemData> item;
    callback activate(string);
    callback remove(string);
    callback favorite-changed(string, bool);
    callback pinned-changed(string, bool);

    height: root.item.has-image ? 98px : 72px;
    background: row-touch.has-hover ? UiPalette.hover : transparent;

    row-touch := TouchArea {
        clicked => { root.activate(root.item.id); }
    }

    Rectangle {
        x: 16px;
        y: 11px;
        width: type-text.preferred-width + 14px;
        height: 20px;
        border-radius: 6px;
        background: UiPalette.accent-soft;

        type-text := Text {
            x: 7px;
            text: root.item.type-label;
            color: UiPalette.accent;
            font-size: 10px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    if root.item.has-image: Rectangle {
        x: 16px;
        y: 38px;
        width: 66px;
        height: 48px;
        border-radius: 6px;
        border-width: 1px;
        border-color: UiPalette.border;
        background: UiPalette.surface;

        Image {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            source: root.item.thumbnail;
            image-fit: contain;
        }
    }

    Text {
        x: root.item.has-image ? 92px : 16px;
        y: 38px;
        width: root.item.has-image ? parent.width - 108px : parent.width - 32px;
        height: root.item.has-image ? 48px : 24px;
        text: root.item.content;
        color: UiPalette.text;
        font-size: 13px;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
    }

    pin-button := RowIconButton {
        x: parent.width - 94px;
        y: 7px;
        icon: @image-url("icons/pin.svg");
        active: root.item.pinned;
        tint: root.item.pinned ? UiPalette.accent : UiPalette.text-muted;
        revealed: row-touch.has-hover || root.item.pinned;
        clicked => { root.pinned-changed(root.item.id, !root.item.pinned); }
    }

    RowIconButton {
        x: parent.width - 64px;
        y: 7px;
        icon: @image-url("icons/trash.svg");
        danger: true;
        revealed: row-touch.has-hover;
        clicked => { root.remove(root.item.id); }
    }

    RowIconButton {
        x: parent.width - 34px;
        y: 7px;
        icon: root.item.favorite ? @image-url("icons/star-filled.svg") : @image-url("icons/star.svg");
        active: root.item.favorite;
        revealed: row-touch.has-hover || root.item.favorite;
        clicked => { root.favorite-changed(root.item.id, !root.item.favorite); }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: UiPalette.border;
    }

    animate background { duration: 100ms; }
}

export component MainWindow inherits Window {
    title: "SnapPaste";
    icon: @image-url("../icons/icon.png");
    no-frame: true;
    width: 264px;
    height: 421px;
    background: transparent;

    in property <[ClipboardItemData]> records;
    in property <bool> favorites-only: false;
    in property <bool> focus-preserving: false;
    in-out property <string> active-panel: "main";
    in-out property <string> search-text;
    in property <string> status-text: "";
    in property <string> app-version: "1.6.0";

    in-out property <string> settings-hotkey: "Alt+Z";
    in-out property <string> settings-theme: "system";
    in-out property <string> settings-keep-days: "1";
    in-out property <string> settings-max-records: "500";
    in-out property <bool> settings-auto-start: false;
    in-out property <string> favorite-draft;

    callback search-changed(string);
    callback refresh-requested();
    callback favorites-toggled();
    callback record-activated(string);
    callback record-removed(string);
    callback favorite-changed(string, bool);
    callback pinned-changed(string, bool);
    callback add-favorite-requested(string);
    callback clear-confirmed();
    callback settings-requested();
    callback settings-save-requested(string, string, string, string, bool);
    callback import-requested();
    callback export-requested();
    callback about-requested();
    callback project-requested();
    callback escape-requested();
    callback window-drag-requested();

    forward-focus: window-key-scope;
    window-key-scope := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.active-panel != "main" {
                    root.active-panel = "main";
                } else {
                    root.escape-requested();
                }
                accept
            } else {
                reject
            }
        }

        app-shell := Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 7px;
            border-width: 1px;
            border-color: UiPalette.border;
            background: UiPalette.window;
            clip: true;

            VerticalLayout {
                header := Rectangle {
                    height: 63px;
                    background: UiPalette.header;

                    drag-area := TouchArea {
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                root.window-drag-requested();
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 8px;

                        Text {
                            text: root.favorites-only ? "收藏" : "历史记录";
                            color: UiPalette.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        IconButton {
                            icon: @image-url("icons/trash.svg");
                            danger: true;
                            enabled: !root.focus-preserving;
                            clicked => { root.active-panel = "clear"; }
                        }
                        IconButton {
                            icon: @image-url("icons/plus.svg");
                            enabled: !root.focus-preserving;
                            clicked => {
                                root.favorite-draft = "";
                                root.active-panel = "add";
                            }
                        }
                        IconButton {
                            icon: root.favorites-only ? @image-url("icons/star-filled.svg") : @image-url("icons/star.svg");
                            active: root.favorites-only;
                            clicked => { root.favorites-toggled(); }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: UiPalette.border;
                    }
                }

                search-area := Rectangle {
                    height: 68px;
                    background: UiPalette.surface;

                    SearchField {
                        x: 18px;
                        y: 14px;
                        width: parent.width - 36px;
                        text <=> root.search-text;
                        enabled: !root.focus-preserving;
                        placeholder-text: root.focus-preserving
                            ? "点击记录即可粘贴"
                            : root.records.length + " 条记录";
                        edited(value) => { root.search-changed(value); }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: UiPalette.border;
                    }
                }

                list-area := Rectangle {
                    vertical-stretch: 1;
                    background: UiPalette.window;

                    if root.records.length == 0: VerticalLayout {
                        alignment: center;
                        spacing: 7px;
                        Text {
                            text: root.favorites-only ? "暂无收藏" : "暂无历史记录";
                            color: UiPalette.text;
                            font-size: 13px;
                            font-weight: 500;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.favorites-only ? "点击星标收藏常用内容" : "复制内容后会自动记录";
                            color: UiPalette.text-faint;
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                    }

                    if root.records.length > 0: ListView {
                        width: 100%;
                        height: 100%;
                        for item in root.records: RecordRow {
                            item: item;
                            activate(id) => { root.record-activated(id); }
                            remove(id) => { root.record-removed(id); }
                            favorite-changed(id, favorite) => { root.favorite-changed(id, favorite); }
                            pinned-changed(id, pinned) => { root.pinned-changed(id, pinned); }
                        }
                    }
                }
            }

            if root.active-panel != "main": Rectangle {
                width: 100%;
                height: 100%;
                background: #0000004d;
                TouchArea { clicked => { root.active-panel = "main"; } }

                if root.active-panel == "settings": Rectangle {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: UiPalette.glass-border;
                    background: UiPalette.window;
                    drop-shadow-blur: 22px;
                    drop-shadow-offset-y: 8px;
                    drop-shadow-color: #0000004d;
                    clip: true;
                    TouchArea { }

                    settings-header := Rectangle {
                        height: 45px;
                        width: 100%;
                        background: UiPalette.header;

                        Text {
                            x: 13px;
                            width: parent.width - 58px;
                            text: "设置";
                            color: UiPalette.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        RowIconButton {
                            x: parent.width - 39px;
                            y: 8px;
                            icon: @image-url("icons/close.svg");
                            tint: UiPalette.text-muted;
                            clicked => { root.active-panel = "main"; }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            width: 100%;
                            background: UiPalette.border;
                        }
                    }

                    settings-body := Rectangle {
                        x: 0;
                        y: 45px;
                        width: 100%;
                        height: parent.height - 92px;
                        background: UiPalette.window;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 9px;
                            padding-bottom: 8px;
                            spacing: 6px;

                            Text { text: "快捷键"; color: UiPalette.text; font-size: 11px; }
                            TextField {
                                text <=> root.settings-hotkey;
                                placeholder-text: "例如 Alt+Z";
                                centered: true;
                            }

                            Text { text: "主题"; color: UiPalette.text; font-size: 11px; }
                            Rectangle {
                                height: 32px;
                                border-width: 1px;
                                border-color: UiPalette.border;
                                border-radius: 8px;
                                background: UiPalette.surface;
                                HorizontalLayout {
                                    padding: 1px;
                                    spacing: 1px;
                                    SegmentButton {
                                        horizontal-stretch: 1;
                                        text: "跟随系统";
                                        selected: root.settings-theme == "system";
                                        clicked => { root.settings-theme = "system"; }
                                    }
                                    SegmentButton {
                                        horizontal-stretch: 1;
                                        text: "浅色";
                                        selected: root.settings-theme == "light";
                                        clicked => { root.settings-theme = "light"; }
                                    }
                                    SegmentButton {
                                        horizontal-stretch: 1;
                                        text: "深色";
                                        selected: root.settings-theme == "dark";
                                        clicked => { root.settings-theme = "dark"; }
                                    }
                                }
                            }

                            HorizontalLayout {
                                height: 59px;
                                spacing: 7px;
                                VerticalLayout {
                                    spacing: 3px;
                                    Text { text: "保留天数"; color: UiPalette.text; font-size: 11px; }
                                    TextField { text <=> root.settings-keep-days; placeholder-text: "0"; }
                                    Text { text: "0 为永久"; color: UiPalette.text-faint; font-size: 9px; }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    Text { text: "最大记录"; color: UiPalette.text; font-size: 11px; }
                                    TextField { text <=> root.settings-max-records; placeholder-text: "0"; }
                                    Text { text: "0 为无限"; color: UiPalette.text-faint; font-size: 9px; }
                                }
                            }

                            HorizontalLayout {
                                height: 31px;
                                Text {
                                    text: "开机启动";
                                    color: UiPalette.text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                ToggleSwitch { checked <=> root.settings-auto-start; }
                            }

                            Rectangle { height: 1px; background: UiPalette.border; }
                            Text { text: "收藏导入导出"; color: UiPalette.text; font-size: 11px; }
                            HorizontalLayout {
                                height: 32px;
                                spacing: 7px;
                                DialogButton {
                                    horizontal-stretch: 1;
                                    text: "导入";
                                    clicked => { root.import-requested(); }
                                }
                                DialogButton {
                                    horizontal-stretch: 1;
                                    text: "导出";
                                    clicked => { root.export-requested(); }
                                }
                            }
                            Text {
                                text: "JSON 增量合并，仅包含收藏内容";
                                color: UiPalette.text-faint;
                                font-size: 9px;
                                overflow: elide;
                            }
                        }
                    }

                    Rectangle {
                        x: 0;
                        y: parent.height - 47px;
                        width: 100%;
                        height: 47px;
                        background: UiPalette.header;
                        Rectangle { width: 100%; height: 1px; background: UiPalette.border; }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 7px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            DialogButton {
                                width: 58px;
                                text: "取消";
                                clicked => { root.active-panel = "main"; }
                            }
                            DialogButton {
                                width: 64px;
                                text: "保存";
                                primary: true;
                                clicked => {
                                    root.settings-save-requested(
                                        root.settings-hotkey,
                                        root.settings-theme,
                                        root.settings-keep-days,
                                        root.settings-max-records,
                                        root.settings-auto-start
                                    );
                                }
                            }
                        }
                    }
                }

                if root.active-panel == "add": Rectangle {
                    x: 16px;
                    y: 100px;
                    width: parent.width - 32px;
                    height: 220px;
                    border-radius: 15px;
                    border-width: 1px;
                    border-color: UiPalette.glass-border;
                    background: UiPalette.surface-strong;
                    drop-shadow-blur: 24px;
                    drop-shadow-offset-y: 8px;
                    drop-shadow-color: #0000004d;
                    TouchArea { }
                    init => { favorite-editor.focus(); }

                    Text {
                        x: 18px;
                        y: 17px;
                        text: "添加收藏";
                        color: UiPalette.text;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    Rectangle {
                        x: 18px;
                        y: 58px;
                        width: parent.width - 36px;
                        height: 92px;
                        border-width: 1px;
                        border-color: favorite-editor.has-focus ? UiPalette.accent : UiPalette.border;
                        border-radius: 8px;
                        background: UiPalette.surface;
                        Text {
                            x: 10px;
                            y: 9px;
                            text: root.favorite-draft == "" ? "输入内容..." : "";
                            color: UiPalette.text-faint;
                            font-size: 13px;
                        }
                        favorite-editor := TextInput {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            height: parent.height - 16px;
                            text <=> root.favorite-draft;
                            color: UiPalette.text;
                            font-size: 13px;
                            wrap: word-wrap;
                            key-pressed(event) => {
                                if event.text == Key.Return && event.modifiers.control && root.favorite-draft != "" {
                                    root.add-favorite-requested(root.favorite-draft);
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }
                    }
                    Text {
                        x: 18px;
                        y: 156px;
                        text: "按 Ctrl+Enter 快速添加";
                        color: UiPalette.text-faint;
                        font-size: 10px;
                    }
                    DialogButton {
                        x: 94px;
                        y: 169px;
                        width: 56px;
                        text: "取消";
                        clicked => { root.active-panel = "main"; }
                    }
                    DialogButton {
                        x: 158px;
                        y: 169px;
                        width: 56px;
                        text: "添加";
                        primary: true;
                        enabled: root.favorite-draft != "";
                        clicked => { root.add-favorite-requested(root.favorite-draft); }
                    }
                }

                if root.active-panel == "clear": Rectangle {
                    x: 25px;
                    y: 132px;
                    width: parent.width - 50px;
                    height: 158px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: UiPalette.glass-border;
                    background: UiPalette.surface-strong;
                    drop-shadow-blur: 24px;
                    drop-shadow-offset-y: 8px;
                    drop-shadow-color: #0000004d;
                    TouchArea { }

                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        Text {
                            text: root.favorites-only ? "清空收藏" : "清空历史";
                            color: UiPalette.text;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.favorites-only ? "将删除全部收藏项目" : "将删除全部非收藏记录";
                            color: UiPalette.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                        HorizontalLayout {
                            height: 34px;
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            DialogButton {
                                width: 56px;
                                text: "取消";
                                clicked => { root.active-panel = "main"; }
                            }
                            DialogButton {
                                width: 56px;
                                text: "清空";
                                danger: true;
                                clicked => { root.clear-confirmed(); }
                            }
                        }
                    }
                }

                if root.active-panel == "about": Rectangle {
                    x: 16px;
                    y: 40px;
                    width: parent.width - 32px;
                    height: 342px;
                    border-radius: 15px;
                    border-width: 1px;
                    border-color: UiPalette.glass-border;
                    background: UiPalette.surface-strong;
                    drop-shadow-blur: 24px;
                    drop-shadow-offset-y: 8px;
                    drop-shadow-color: #0000004d;
                    TouchArea { }

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "SnapPaste";
                            color: UiPalette.text;
                            font-size: 18px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "轻量、快速的 Windows 剪贴板工具";
                            color: UiPalette.text-muted;
                            font-size: 10px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "版本 v" + root.app-version + "  ·  作者 21b";
                            color: UiPalette.text-muted;
                            font-size: 10px;
                            horizontal-alignment: center;
                        }
                        Rectangle {
                            height: 31px;
                            border-width: 1px;
                            border-color: UiPalette.border;
                            border-radius: 8px;
                            background: UiPalette.surface;
                            Text {
                                x: 9px;
                                width: parent.width - 34px;
                                text: "github.com/l21b/SnapPaste";
                                color: UiPalette.text-muted;
                                font-size: 10px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Image {
                                x: parent.width - 25px;
                                y: 8px;
                                width: 14px;
                                height: 14px;
                                source: @image-url("icons/external.svg");
                                colorize: UiPalette.text-muted;
                            }
                            TouchArea { clicked => { root.project-requested(); } }
                        }
                        Rectangle {
                            height: 94px;
                            border-width: 1px;
                            border-color: UiPalette.border;
                            border-radius: 8px;
                            background: UiPalette.surface;
                            clip: true;
                            AboutSlint { }
                        }
                        Text {
                            text: "界面由 Slint 驱动，数据只保存在本机";
                            color: UiPalette.text-faint;
                            font-size: 9px;
                            horizontal-alignment: center;
                        }
                        Rectangle { vertical-stretch: 1; }
                        DialogButton {
                            height: 34px;
                            text: "知道了";
                            primary: true;
                            clicked => { root.active-panel = "main"; }
                        }
                    }
                }
            }

            if root.status-text != "": Rectangle {
                x: 12px;
                y: parent.height - 42px;
                width: parent.width - 24px;
                height: 30px;
                border-radius: 8px;
                background: UiPalette.dark-mode ? #111827ed : #20242bed;
                drop-shadow-blur: 10px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: #00000040;
                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: root.status-text;
                    color: #ffffff;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
